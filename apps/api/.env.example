# Local development settings for `pnpm dev`. Copy to apps/api/.env and adjust.
# Never commit real secrets: .env files are git-ignored.
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
RUN_MIGRATIONS=true

ORG_NAME=My company
# Verified emails that become org owners on first sign-in.
ORG_OWNER_EMAILS=alice@example.com

# Any OIDC provider works. These values match the Keycloak in deploy/compose.
OIDC_ISSUER=http://localhost:8080/realms/platform
OIDC_CLIENT_ID=platform
OIDC_CLIENT_SECRET=dev-secret
OIDC_ALLOW_HTTP=true
OIDC_GROUPS_CLAIM=groups

# The dev Keycloak sends no amr claim, so treat every login as MFA. Never use this in production
# (the API refuses to start with it there); use MFA_EVIDENCE=amr or acr with your real IdP.
MFA_EVIDENCE=assume

COOKIE_SECURE=false
COOKIE_SECRET=replace-with-a-random-string-of-at-least-32-characters

AUDIT_SEAL_INTERVAL_SECONDS=30
# Create a signing key with `pnpm --filter @platform/api audit:keygen` and paste the private key here
# (quoted, with \n line breaks). Without one, a temporary key is used and old seals can't be verified.
# AUDIT_SIGNING_KEY_PEM=

LOG_LEVEL=info

# Files people upload, such as receipts, are kept with each app's data (FILE_STORE=postgres), or in an
# S3-compatible store (FILE_STORE=s3 with S3_BUCKET, S3_REGION, S3_ENDPOINT and keys).
# Without a malware scanner, uploads are marked as not scanned here; production refuses them.
# FILE_SCANNER=clamav
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
