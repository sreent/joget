{
  "name": "@platform/app-model",
  "version": "0.1.0",
  "private": true,
  "description": "App definitions (entities, rules, actions, queries, review cards, roles): validation, migration plans, and the SQL behind record-level permissions.",
  "type": "module",
  "exports": {
    ".": {
