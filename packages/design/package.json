{
  "name": "@platform/design",
  "version": "0.1.0",
  "private": true,
  "description": "Ambit's look: Ocean's tokens, pieces and fonts, taken from sreent/ocean at a commit (ocean.json), and the styles of Ambit's pages.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "source": "./src/icons.ts",
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./ocean.css": "./ocean.css",
    "./ambit.css": "./ambit.css",
    "./ocean-pieces.css": "./ocean-pieces.css"
  },
  "files": [
    "dist",
    "ocean.css",
    "ambit.css",
    "fonts",
    "ocean-pieces.css",
    "ocean.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
