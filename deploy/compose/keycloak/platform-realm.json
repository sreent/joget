{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [{ "name": "platform-admins" }, { "name": "builders" }, { "name": "finance" }],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Owner",
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "groups": ["/platform-admins"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Finance",
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "groups": ["/finance"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Builder",
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }],
      "groups": ["/builders"]
    }
  ],
  "clients": [
    {
      "clientId": "platform",
      "name": "Platform (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback", "http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
