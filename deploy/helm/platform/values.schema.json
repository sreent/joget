{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform chart values",
  "type": "object",
  "required": ["existingSecret", "image", "config"],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "description": "A Secret holding DATABASE_URL, COOKIE_SECRET, AUDIT_SIGNING_KEY_PEM (and OIDC_CLIENT_SECRET)."
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "config": {
      "type": "object",
      "required": ["PUBLIC_BASE_URL", "OIDC_ISSUER", "OIDC_CLIENT_ID"],
      "properties": {
        "PUBLIC_BASE_URL": { "type": "string", "pattern": "^https://" },
        "OIDC_ISSUER": { "type": "string", "pattern": "^https://" },
        "OIDC_CLIENT_ID": { "type": "string", "minLength": 1 },
        "MFA_EVIDENCE": { "enum": ["amr", "acr"] }
      },
      "not": {
        "anyOf": [
          { "required": ["DATABASE_URL"] },
          { "required": ["COOKIE_SECRET"] },
          { "required": ["AUDIT_SIGNING_KEY_PEM"] },
          { "required": ["OIDC_CLIENT_SECRET"] }
        ]
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": ["integer", "string"] } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "egress": { "type": "array" }
      }
    }
  }
}
