{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "platform chart values",
  "type": "object",
  "required": ["existingSecret", "image", "config"],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1,
      "description": "A Secret holding DATABASE_URL, COOKIE_SECRET, AUDIT_SIGNING_KEY_PEM (and OIDC_CLIENT_SECRET)."
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "a7c": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^(https://.+)?$", "description": "a7c's control plane. Empty: skill calls wait in the outbox." },
        "tokenSecret": { "type": "string", "description": "A Secret with Ambit's a7c token under the key token." }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["", "anthropic"], "description": "The model provider of the studio's chat. Empty: the chat is off." },
        "model": { "type": "string", "description": "The model's ID at the provider." },
        "keySecret": { "type": "string", "description": "A Secret with the provider's API key under the key key." },
        "baseUrl": { "type": "string", "pattern": "^(https://.+)?$", "description": "A gateway in front of the provider. Empty: the provider's own address." },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "off"] },
        "fallback": { "enum": ["default", "off"] },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "config": {
      "type": "object",
      "required": ["PUBLIC_BASE_URL", "OIDC_ISSUER", "OIDC_CLIENT_ID"],
      "properties": {
        "PUBLIC_BASE_URL": { "type": "string", "pattern": "^https://" },
        "OIDC_ISSUER": { "type": "string", "pattern": "^https://" },
        "OIDC_CLIENT_ID": { "type": "string", "minLength": 1 },
        "MFA_EVIDENCE": { "enum": ["amr", "acr"] },
        "FILE_STORE": { "enum": ["postgres", "s3"] },
        "FILE_SCANNER": { "enum": ["clamav"], "description": "Production refuses uploads without a malware scanner." },
        "S3_ENDPOINT": { "type": "string", "pattern": "^https://" },
        "CHANGE_APPROVALS": { "type": "string", "pattern": "^[1-5]$" },
        "DEPLOY_PROD_APPROVALS": { "type": "string", "pattern": "^[1-5]$" },
        "SKILL_DISPATCH_INTERVAL_SECONDS": { "type": "string", "pattern": "^[0-9]+$" },
        "SKILL_CALL_MAX_ATTEMPTS": { "type": "string", "pattern": "^([1-9]|[1-4][0-9]|50)$" },
        "PROCESS_TIMER_INTERVAL_SECONDS": { "type": "string", "pattern": "^[0-9]+$" }
      },
      "not": {
        "anyOf": [
          { "required": ["DATABASE_URL"] },
          { "required": ["COOKIE_SECRET"] },
          { "required": ["AUDIT_SIGNING_KEY_PEM"] },
          { "required": ["OIDC_CLIENT_SECRET"] },
          { "required": ["S3_ACCESS_KEY_ID"] },
          { "required": ["S3_SECRET_ACCESS_KEY"] },
          { "required": ["A7C_URL"], "description": "Set a7c.url instead, so the token Secret is mounted with it." },
          { "required": ["A7C_TOKEN_FILE"] },
          { "required": ["AI_PROVIDER"], "description": "Set ai.provider instead, so the key Secret is mounted with it." },
          { "required": ["AI_API_KEY_FILE"] }
        ]
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": ["integer", "string"] } }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "egress": { "type": "array" }
      }
    }
  }
}
